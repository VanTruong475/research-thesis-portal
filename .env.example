# Application
APP_NAME=Research Thesis Portal API
APP_VERSION=0.1.0
APP_ENV=development
APP_DEBUG=true

# PostgreSQL
POSTGRES_DB=thesis_db
POSTGRES_USER=thesis_user
POSTGRES_PASSWORD=replace-with-secure-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5433

# Database URLs
# Use localhost and POSTGRES_HOST_PORT for local Alembic commands.
DATABASE_URL=postgresql+asyncpg://thesis_user:replace-with-secure-password@localhost:5433/thesis_db
# Use db and POSTGRES_PORT from inside Docker containers.
DOCKER_DATABASE_URL=postgresql+asyncpg://thesis_user:replace-with-secure-password@db:5432/thesis_db
